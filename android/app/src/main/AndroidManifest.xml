<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No storage permissions: the setup screen reaches the game folder
         through the Storage Access Framework and the log export goes through
         MediaStore, neither of which needs one. -->

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- First-run screen: picks the original game folder and the control
             layout, then launches the game activity. Landscape is locked on
             both activities: a sensor-landscape request came back as portrait
             on at least one Transsion/Unisoc device. -->
        <activity
            android:name=".SetupActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The game itself, running through SDLActivity. The configChanges
             list is the one SDL requires to survive rotation and theme
             changes without recreating the native thread. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|density|fontScale|layoutDirection|locale|mcc|mnc|navigation|smallestScreenSize|touchscreen"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape" />
    </application>
</manifest>
